# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Test and coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Model bundle weights are downloaded from a pinned immutable revision and verified
# against models/artifacts/manifest.json. The manifest is committed so that a fresh clone
# can verify a bundle it obtained independently; the weights themselves are not.
models/artifacts/*
!models/artifacts/manifest.json

# Local benchmark and evidence output. Baselines under benchmarks/baselines/ ARE
# committed; candidate runs are not. Anchored to the root so that it cannot also swallow
# models/artifacts/.
benchmarks/out/
/artifacts/

# Local environment
.env

# Internal design and audit documents. They are the specification this implementation was
# built against and are deliberately not published: the repository ships what a user needs
# to run and understand PRISM, not the working material behind it.
PRISM_ARCHITECTURE*.md
PRISM_IMPLEMENTATION_PLAN*.md
PRISM_SYSTEM_DESIGN_TECH_STACK*.md

# Session state. Working material, not part of the published surface.
STATE.md
